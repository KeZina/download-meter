{
  "name": "download-meter",
  "version": "1.0.0",
  "description": "Console tool that knocks on a URL a fixed number of times and reports download speed",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "download-meter": "dist/main.js"
  },
  "scripts": {
    "knock": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "silly-logger": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0"
  }
}
